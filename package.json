{
  "name": "tastepolicy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:qloo": "node scripts/verify-qloo.mjs",
    "agent": "node --experimental-transform-types --conditions=react-server --import ./scripts/source-imports.mjs ./scripts/agent.mjs",
    "test:database": "vitest run tests/state.test.ts tests/interactive.test.ts tests/trajectory.test.ts tests/subjects.test.ts tests/platform.test.ts",
    "db:migrate": "node scripts/state-db.mjs migrate",
    "db:migrate:trajectory": "node scripts/state-db.mjs migrate-trajectory",
    "db:migrate:subjects": "node scripts/state-db.mjs migrate-subjects",
    "db:migrate:platform": "node scripts/state-db.mjs migrate-platform",
    "db:migrate:policy": "node scripts/state-db.mjs migrate-policy",
    "db:migrate:leases": "node scripts/state-db.mjs migrate-leases",
    "db:migrate:attestations": "node scripts/state-db.mjs migrate-attestations",
    "conformance:attest": "node --experimental-transform-types --import ./scripts/source-imports.mjs ./scripts/conformance/run-attest.mjs",
    "conformance:attest:generate": "node --experimental-transform-types --import ./scripts/source-imports.mjs ./scripts/conformance/generate-attest-vectors.ts && prettier --write conformance",
    "mcp:platform": "node --experimental-transform-types scripts/platform-mcp.mjs",
    "db:purge:platform": "node scripts/state-db.mjs purge-platform",
    "db:purge": "node scripts/state-db.mjs purge",
    "db:migrate:interactive": "node scripts/state-db.mjs migrate-interactive",
    "tastebench:validate": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts validate",
    "tastebench:contract": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts contract",
    "tastebench:run": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts run",
    "tastebench:report": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts report",
    "tastebench:export": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts export",
    "tastebench:annotations": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts import-annotations",
    "tastebench:calibration": "node --experimental-transform-types --conditions=react-server --import ./scripts/tastebench-imports.mjs ./scripts/tastebench.ts calibration"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.10",
    "jose": "6.2.13",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@electric-sql/pglite": "0.5.10",
    "@modelcontextprotocol/client": "2.4.0",
    "@owf/token-status-list": "0.5.0",
    "@playwright/test": "^1.56.1",
    "@sd-jwt/core": "0.23.1",
    "@sd-jwt/sd-jwt-vc": "0.23.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10",
    "jsdom": "^27",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}

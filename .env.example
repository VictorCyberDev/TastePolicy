# Boot/tests require no external credentials. Optional public canonical URL:
NEXT_PUBLIC_APP_URL=
# Server-only Qloo credential; leave blank while awaiting provisioning.
QLOO_API_KEY=
# Future unused providers:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Future browser credential only; never use a service role here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Select only the exact origin specified in your Qloo credential email.
# Allowed: https://hackathon.api.qloo.com or https://api.qloo.com
QLOO_API_BASE_URL=
# Set ONLY after checking the actual wire affinity scale: unit or percent.
# Never infer a scale from a single score. Missing scale disables inference/evaluation.
QLOO_AFFINITY_SCALE=

# Event-host observation (2026-10-13): query.affinity uses unit values.
# Use QLOO_AFFINITY_SCALE=unit only for this verified contract; reverify other hosts.

# Optional M2 server-only PostgreSQL connection. No browser table access.
# Use a dedicated TastePolicy database role with verified TLS in hosted environments.
DATABASE_URL=

# M6 server-only authentication. No defaults; boot/demo work without these.
# Generate a high-entropy value of at least 32 characters privately.
BETTER_AUTH_SECRET=
# Explicit trusted HTTPS account origin (localhost allowed only for development).
BETTER_AUTH_URL=

# M24 optional server-only Google Maps Platform key (Places API New + Routes API).
# Never expose to the browser. Without it, place photos/accessibility/travel time
# stay unknown and the experience uses licensed Wikimedia / authored fallbacks.
GOOGLE_MAPS_API_KEY=

# M25 optional server-only keys for the open place experience. The zero-credential
# core (MapLibre + OpenFreeMap, OpenStreetMap/Nominatim/Overpass, KartaView,
# Panoramax, Wikimedia) needs none of them.
# HeiGIT-hosted openrouteservice (https://api.heigit.org). Free Standard key.
# Without it, routes and walking times stay unknown; nothing is invented.
HEIGIT_API_KEY=
# Mapillary access token (optional extra street-imagery coverage).
MAPILLARY_ACCESS_TOKEN=
